{
  "name": "zenzo-redesign",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/zenzo-redesign/ --outDir dist-pages",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview --port 4173 --strictPort",
    "assets:fetch": "node scripts/fetch-assets.ts",
    "assets": "node scripts/build-assets.ts",
    "qa": "node scripts/qa.ts",
    "preview:pages": "node scripts/serve-static.ts dist-pages /zenzo-redesign/ 4174",
    "qa:pages": "node scripts/qa-pages.ts",
    "qa:links": "node scripts/qa-links.ts",
    "qa:nl": "node scripts/qa-nl.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "lucide-react": "^1.63.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
